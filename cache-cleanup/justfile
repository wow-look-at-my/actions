[private]
help:
	@just --list

# esbuild bundles straight from the TypeScript entrypoint, so sources outside
# this directory (../shared/cache-xfer) resolve like any other import and no
# stray per-module .js is left in dist/ to ship in the release tag. tsc is the
# typecheck only.
build:
	pnpm install
	pnpm tsc --noEmit
	pnpm esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js
