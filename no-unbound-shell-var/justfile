build:
	pnpm install
	pnpm tsc
	pnpm esbuild dist/index.js --bundle --platform=node --target=node24 --outfile=dist/index.js --allow-overwrite
	# scan, shell and yaml are bundled into index.js above; drop the leftover tsc output.
	rm -f dist/scan.js dist/scan.test.js dist/shell.js dist/yaml.js
