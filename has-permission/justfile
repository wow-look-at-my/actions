[private]
help:
	@just --list

build:
	pnpm install
	pnpm tsc
	pnpm esbuild dist/index.js --bundle --platform=node --target=node24 --outfile=dist/index.js --allow-overwrite
	# permissions is bundled into index.js above, so its own tsc output is dropped here.
	rm -f dist/permissions.js dist/permissions.test.js
