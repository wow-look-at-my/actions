[private]
help:
	@just --list

build:
	pnpm install
	pnpm tsc
	pnpm esbuild dist/index.js --bundle --platform=node --target=node24 --outfile=dist/index.js --allow-overwrite
	# lint is bundled into index.js above; drop the leftover tsc output so it
	# does not ship in the orphan release tag.
	rm -f dist/lint.js dist/lint.test.js dist/ste100-banned-words.js dist/submodules.js dist/submodules.test.js
